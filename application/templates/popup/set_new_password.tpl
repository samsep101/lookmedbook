<div id="new-pass-popup" class="popup">
    <img class="logo" src="/media/images/main_logo.png" alt="">
    <p class="intro">Введи новый пароль</p>
    <div class="form forgot-form">
        <div id="forgotpass-form">

            <div class="row flo">
                <div class="txt">
                    <input type="password" id="set_password" class="password-field" name="password" placeholder="Пароль">
                </div>
            </div>
            <div class="row flo repeat_pass">
                <div class="txt">
                    <input type="password" id="set_repeat_password" class="password-field" placeholder="Повторите пароль"/>
                </div>
            </div>

            <div class="btns">
                <input type="button" value="Восстановить пароль" class="btn-1" id="set_new_password">
            </div>
        </div>
    </div>
</div>