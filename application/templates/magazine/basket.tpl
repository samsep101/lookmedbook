<div class="magazine inner-2 flo">
    <h2 class="h-basket">Корзина<a class="back" href="#">Вернуться к покупкам</a></h2>
    <div class="bg_gradient basket flo">
        <div class="basket_head">
            <span class="count">Всего: <span class="count_all_good"></span> позиций</span><span class="basket_price">на сумму <span class="price_all_good"></span></span>
            <a class="btn-appoint" href="javascript:void(0)">Оформить заказ</a>
            <a class="basket_clear" href="javascript:void(0)">Очистить заказ</a>
        </div>

        <div class="basket_good buy flo">
            <img src="http://brugs.ru/images/i/polza-i-vred-lekarstv/mogushhestvennoe-oruzhie-medicziny/mikroby-delayut-lekarstva/shutterstock_9826267.jpg">
            <div class="about">
                <p class="goodname">Название таблеток</p>
                <p class="goodprod">Производство</p>
            </div>
            <div class="goodcount">
                <p class="hb">Количество</p>
                <ul class="numeric">
                    <li onclick="spin(1, this)">-</li>
                    <li class="count">1</li>
                    <li onclick="spin(-1, this)">+</li>
                </ul>
                <span>шт.</span>
            </div>
            <div class="goodprice">
                <p class="hb">Стоимость</p>
                <span class="product_price"><b class="gprice">100</b><b class="total_price">100</b><b>р.</b></span>
            </div>
            <span class="del_good"></span>
        </div>

        <div class="basket_good flo">
            <p class="deleted">Таблетки клуглые, 20шт. <a href="javascript:void(0)">Восстановить</a></p>
        </div>

        <div class="basket_good buy flo">
            <img src="http://brugs.ru/images/i/polza-i-vred-lekarstv/mogushhestvennoe-oruzhie-medicziny/mikroby-delayut-lekarstva/shutterstock_9826267.jpg">
            <div class="about">
                <p class="goodname">Название таблеток</p>
                <p class="goodprod">Производство</p>
            </div>
            <div class="goodcount">
                <p class="hb">Количество</p>
                <ul class="numeric">
                    <li onclick="spin(1, this)">-</li>
                    <li class="count">2</li>
                    <li onclick="spin(-1, this)">+</li>
                </ul>
                <span>шт.</span>
            </div>
            <div class="goodprice">
                <p class="hb">Стоимость</p>
                <span class="product_price"><b class="gprice">200</b><b class="total_price">200</b><b>р.</b></span>
            </div>
            <span class="del_good"></span>
        </div>

        <div class="basket_total">
            <div class="shadow_check"></div>
            <p class="total_line">
                <span class="count">Всего: <span class="like_i"><span class="count_all_good">0</span>товаров на</span></span><span class="basket_price"><span class="price_all_good">0</span> <small class="f15">р.</small></span>
                <a class="btn-appoint" href="javascript:void(0)">Оформить заказ</a>
            </p>
        </div>
    </div>
</div>